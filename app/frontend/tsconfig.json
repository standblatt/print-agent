{
	"extends": "@tsconfig/svelte/tsconfig.json",
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"isolatedModules": true,
		"paths": {
			"$lib/*": ["./src/lib/*"],
			"$locales/*": ["./src/locales/*"],
			"$bindings/*": ["./bindings/github.com/standblatt/print-agent/*"]
		}
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "bindings"]
}
